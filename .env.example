# ============================================================
# ASTRA — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ========================
# Application
# ========================
ASTRA_APP_NAME=ASTRA
ASTRA_VERSION=0.1.0
ASTRA_ENV=development
ASTRA_DEBUG=true

# ========================
# Backend Server
# ========================
ASTRA_HOST=0.0.0.0
ASTRA_PORT=8000
ASTRA_CORS_ORIGINS=http://localhost:5173

# ========================
# Database (PostgreSQL)
# ========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ========================
# AI Provider
# ========================
ASTRA_AI_PROVIDER=gemini
ASTRA_AI_MODEL=gemini-2.0-flash

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (future)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Anthropic (future)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ========================
# Security
# ========================
ASTRA_SECRET_KEY=changeme_generate_a_real_secret_key
# ASTRA_JWT_ALGORITHM=HS256
# ASTRA_JWT_EXPIRATION_MINUTES=1440

# ========================
# Logging
# ========================
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FORMAT=json

# ========================
# Feature Flags
# ========================
ASTRA_FEATURE_VOICE=false
ASTRA_FEATURE_MEMORY=false
ASTRA_FEATURE_KNOWLEDGE=false
ASTRA_FEATURE_TOOLS=false
ASTRA_FEATURE_AGENTS=false
ASTRA_FEATURE_NOTCH=false

# ========================
# Voice (future)
# ========================
# ASTRA_STT_PROVIDER=
# ASTRA_TTS_PROVIDER=
# ASTRA_WAKE_WORD=astra

# ========================
# Storage (future)
# ========================
# ASTRA_STORAGE_PATH=./data
# ASTRA_MAX_UPLOAD_SIZE_MB=50
