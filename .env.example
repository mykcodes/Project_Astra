# ============================================================
# ASTRA — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ========================
# Application
# ========================
ASTRA_APP_NAME=ASTRA
ASTRA_VERSION=0.1.0
ASTRA_ENV=development
ASTRA_DEBUG=true

# ========================
# Backend Server
# ========================
ASTRA_HOST=0.0.0.0
ASTRA_PORT=8000
ASTRA_CORS_ORIGINS=http://localhost:5173

# ========================
# Database (PostgreSQL)
# ========================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=astra
POSTGRES_USER=astra
POSTGRES_PASSWORD=changeme_in_production
DATABASE_URL=postgresql+asyncpg://astra:changeme_in_production@localhost:5432/astra

# ========================
# AI Provider
# ========================
# ASTRA_AI_PROVIDER selects which LLM backend to use.
# Currently supported: gemini
# Future: groq, mistral, openrouter, cerebras
ASTRA_AI_PROVIDER=gemini
ASTRA_AI_MODEL=gemini-3.6-flash

# Provider Resilience
ASTRA_AI_FALLBACK_PROVIDERS=groq
ASTRA_PROVIDER_COOLDOWN_SECONDS=60

# Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (future)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Mistral (future)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# OpenRouter (future)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Local Provider
ASTRA_LOCAL_ENABLED=true
ASTRA_LOCAL_RUNTIME=openai
ASTRA_LOCAL_MODEL=qwen/qwen3.5-9b
ASTRA_LOCAL_BASE_URL=http://localhost:1234/v1
ASTRA_LOCAL_CONTEXT_LENGTH=2048
ASTRA_LOCAL_MAX_TOKENS=1024
ASTRA_LOCAL_TEMPERATURE=0.7
ASTRA_OFFLINE_MODE=false

# Cerebras (future)
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=

# ========================
# Security
# ========================
ASTRA_SECRET_KEY=changeme_generate_a_real_secret_key
# ASTRA_JWT_ALGORITHM=HS256
# ASTRA_JWT_EXPIRATION_MINUTES=1440

# ========================
# Logging
# ========================
ASTRA_LOG_LEVEL=INFO
ASTRA_LOG_FORMAT=json

# ========================
# Feature Flags
# ========================
ASTRA_FEATURE_VOICE=false
ASTRA_FEATURE_MEMORY=false
ASTRA_FEATURE_KNOWLEDGE=false
ASTRA_FEATURE_TOOLS=false
ASTRA_FEATURE_AGENTS=false
ASTRA_FEATURE_NOTCH=false

# ========================
# Voice (future)
# ========================
# ASTRA_STT_PROVIDER=
# ASTRA_TTS_PROVIDER=
# ASTRA_WAKE_WORD=astra

# ========================
# Storage (future)
# ========================
# ASTRA_STORAGE_PATH=./data
# ASTRA_MAX_UPLOAD_SIZE_MB=50
